{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aetridder.extractor-error.schema.json",
  "title": "Extractor v1 error response",
  "type": "object",
  "required": ["protocolVersion", "ok", "jobId", "generation", "requestId", "errorCode", "errorMessageSafe", "retryable", "extractor"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "extractor.v1" },
    "ok": { "const": false },
    "jobId": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "requestId": { "type": "string", "minLength": 1 },
    "errorCode": {
      "type": "string",
      "enum": [
        "extractor_unavailable",
        "extractor_timeout",
        "extractor_unauthorized",
        "extractor_bad_response",
        "extractor_schema_invalid",
        "reddit_unavailable",
        "reddit_verification_or_block_page",
        "reddit_login_gated"
      ]
    },
    "errorMessageSafe": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "extractor": {
      "type": "object",
      "required": ["provider", "agentVersion", "startedAt", "endedAt", "browserReady"],
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string" },
        "agentVersion": { "type": ["string", "null"] },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "browserReady": { "type": ["boolean", "null"] }
      }
    }
  }
}
