{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aetridder.translated-comment-batch.schema.json",
  "title": "Reddit Reader translated comment batch",
  "type": "object",
  "required": ["schemaVersion", "language", "translatedAt", "batchIndex", "totalBatches", "comments", "warningCodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "aetridder.translated-comment-batch.v1" },
    "language": { "type": "string" },
    "translatedAt": { "type": "string" },
    "batchIndex": { "type": "integer" },
    "totalBatches": { "type": "integer" },
    "comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/comment" }
    },
    "warningCodes": {
      "type": "array",
      "items": { "type": "string", "enum": ["partial_translation"] }
    }
  },
  "$defs": {
    "comment": {
      "type": "object",
      "required": ["id", "parentId", "order", "depth", "bodyMarkdown"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "order": { "type": "integer" },
        "depth": { "type": "integer" },
        "bodyMarkdown": { "type": "string" }
      }
    }
  }
}
