# No real secrets in this file.
# Copy to .env locally only when the app implementation explicitly needs it.

# Optional future token. Do not commit a real value.
AETRIDDER_API_TOKEN=

# Optional separate diagnostics token, if the implementation later needs one.
AETRIDDER_DIAGNOSTICS_TOKEN=

# Runtime limits/placeholders.
AETRIDDER_HTTP_PORT=4173
AETRIDDER_PUBLIC_URL_ALLOWLIST=reddit.com,redd.it,www.reddit.com,old.reddit.com
AETRIDDER_EXTRACTION_TIMEOUT_MS=90000
AETRIDDER_TRANSLATION_TIMEOUT_MS=180000
AETRIDDER_TOTAL_JOB_TIMEOUT_MS=300000
AETRIDDER_MAX_INPUT_CHARS=300000
AETRIDDER_MAX_ARTIFACT_BYTES=10485760
AETRIDDER_REDACTED_LOG_TAIL_BYTES=32768
AETRIDDER_CODEX_PROCESS_TIMEOUT_MS=180000
AETRIDDER_MAX_COMMENTS=1000

# Optional local override when Codex CLI is not on PATH.
# Leave unset for the product default. Do not put credentials or private config here.
# CODEX_CLI_PATH=C:\local\path\to\codex.cmd

