# No real secrets in this file.
# Copy to .env locally only when the app implementation explicitly needs it.

# Optional future token. Do not commit a real value.
REDDIT_READER_API_TOKEN=

# Optional separate diagnostics token, if the implementation later needs one.
REDDIT_READER_DIAGNOSTICS_TOKEN=

# Runtime limits/placeholders.
# Production deployments may intentionally override these values in env_file and/or Docker Compose inline environment.
REDDIT_READER_HTTP_PORT=4173
REDDIT_READER_HTTP_HOST=127.0.0.1
REDDIT_READER_PUBLIC_URL_ALLOWLIST=reddit.com,redd.it,www.reddit.com,old.reddit.com
REDDIT_READER_EXTRACTION_TIMEOUT_MS=90000
REDDIT_READER_TRANSLATION_TIMEOUT_MS=180000
REDDIT_READER_TOTAL_JOB_TIMEOUT_MS=300000
REDDIT_READER_MAX_INPUT_CHARS=300000
REDDIT_READER_MAX_ARTIFACT_BYTES=10485760
REDDIT_READER_MAX_COMMENT_PARTIAL_REQUESTS=50
REDDIT_READER_MAX_COMMENT_PARTIAL_BYTES=10485760
REDDIT_READER_COMMENT_PARTIAL_IDLE_MS=0
REDDIT_READER_REDACTED_LOG_TAIL_BYTES=32768
REDDIT_READER_CODEX_PROCESS_TIMEOUT_MS=180000
REDDIT_READER_CODEX_BATCH_TIMEOUT_MS=300000
REDDIT_READER_TRANSLATION_BATCH_MAX_COMMENTS=10
REDDIT_READER_TRANSLATION_BATCH_MAX_CHARS=20000
REDDIT_READER_TRANSLATION_CONCURRENCY=10
REDDIT_READER_CODEX_USAGE_HISTORY_LIMIT=30
# Debug/telemetry pages are protected by diagnostics auth by default.
# Set to 1 only for an explicitly private shakedown deployment.
REDDIT_READER_PUBLIC_DEBUG_PAGES=0
REDDIT_READER_MAX_COMMENTS=1000

# Translation target. The public repository default is Ukrainian.
# Deployments may override these values for another native language.
REDDIT_READER_TARGET_LANGUAGE_CODE=uk
REDDIT_READER_TARGET_LANGUAGE_NAME=Ukrainian
REDDIT_READER_TARGET_LOCALE=uk-UA

# Extraction placement.
# playwright = app runtime extracts directly.
# external = app runtime calls REDDIT_READER_EXTERNAL_EXTRACTOR_URL, usually through a reverse SSH tunnel to a laptop agent.
REDDIT_READER_EXTRACTION_MODE=playwright
# Explicit provider selector. auto derives from REDDIT_READER_EXTRACTION_MODE.
EXTRACTOR_PROVIDER=auto
EXTRACTOR_PROTOCOL_VERSION=extractor.v1
EXTRACTOR_TIMEOUT_MS=90000
EXTRACTOR_HEALTH_TIMEOUT_MS=5000
EXTRACTOR_MAX_CONSECUTIVE_FAILURES=3
EXTRACTOR_CIRCUIT_COOLDOWN_MS=30000
# REDDIT_READER_EXTERNAL_EXTRACTOR_URL=http://127.0.0.1:4182/extract
# REDDIT_READER_EXTERNAL_EXTRACTOR_TOKEN=
# New aliases for the same private remote extractor endpoint/token.
# EXTRACTOR_REMOTE_URL=http://127.0.0.1:4182/extract
# EXTRACTOR_TOKEN=

# Local laptop extractor agent settings for npm run start:extractor-agent.
REDDIT_READER_EXTRACTOR_AGENT_HOST=127.0.0.1
REDDIT_READER_EXTRACTOR_AGENT_PORT=4181
# REDDIT_READER_EXTRACTOR_AGENT_TOKEN=

# Optional local override when Codex CLI is not on PATH.
# Leave unset for the product default. Do not put credentials or private config here.
# CODEX_CLI_PATH=C:\local\path\to\codex.cmd

# Optional Codex translation model controls. Defaults preserve the original MVP behavior.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=high
